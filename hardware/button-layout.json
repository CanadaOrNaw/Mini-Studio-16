  "contexts": {
    "global": {
      "title":"Global",
      "summary":"Track, pattern, transport, project and page controls are always close at hand.",
      "keys":["grave","1","2","3","4","5","6","7","8","9","0","minus","equals","delete","control","option","alt","x","c","v","b","space"]
    },
    "pattern": {
      "title":"Pattern",
      "summary":"Play the keyboard or drum pads, record into 16 steps, clear cells and switch the A/B pattern bank.",
      "keys":["tab","fn","shift","a","s","d","f","g","h","j","k","l","semicolon","quote","enter","q","w","r","t","y","i","o","left-bracket","right-bracket","backslash","z","comma","slash","m"]
    },
    "sound": {
      "title":"Sound",
      "summary":"Select MG/303, MGX or FM4; cycle compact parameter banks and edit rows with the arrows.",
      "keys":["tab","x","c","v","b","m","fn","shift","a","s","d","f","g","h"]
    },
    "sample": {
      "title":"Sample",
      "summary":"Browse or assign 16 slots, perform melodic/sliced sounds, edit locks, and capture mic or master bus.",
      "keys":["tab","x","c","v","b","n","m","comma","period","slash","fn","shift","a","s","d","f","g","h","j","k","l","semicolon","quote","enter","q","w"]
    },
    "loops": {
      "title":"Loops",
      "summary":"Record six synchronized SD-backed loops; select, level, mute or clear each independent track.",
      "keys":["4","5","6","7","8","9","x","c","v","b","z","period","slash"]
    },
    "event": {
      "title":"Event",
      "summary":"Arm, mute and size five role-based event tracks from 1 to 128 bars.",
      "keys":["4","5","6","7","8","x","c","v","b","z","period","slash"]
    },
    "motion": {
      "title":"Motion",
      "summary":"Map tilt, acceleration, gyro, shake or slap to synth parameters, MIDI CC and event automation.",
      "keys":["x","c","v","b","z","period"]
    },
    "song": {
      "title":"Song + record",
      "summary":"Arrange a 128-entry chain, set the loop start, choose projects, and capture master WAV or five stems.",
      "keys":["4","5","6","7","8","9","0","minus","option","alt","z","n","period","space"]
    },
    "diag": {
      "title":"SD test",
      "summary":"Start the on-device sequential and round-robin SD diagnostic before trusting a card for long audio.",
      "keys":["slash"]
    }
  }
}
